[sub_resource type="Shader" id="Shader_shield_reflect_feedback"]
code = "shader_type canvas_item;\n\nuniform vec4 flash_color : source_color = vec4(1.0);\nuniform float flash_strength : hint_range(0.0, 1.0) = 0.0;\n\nvoid fragment() {\n\tvec4 tex_color = texture(TEXTURE, UV);\n\tvec3 display_color = mix(tex_color.rgb, flash_color.rgb, flash_strength);\n\tCOLOR = vec4(display_color, tex_color.a);\n}\n"

